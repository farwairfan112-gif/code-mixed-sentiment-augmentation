{
  "task": "Cross-lingual NLP Reproduction Study",
  "type": "baseline_metrics",
  "datasets": [
    {
      "name": "Malayalam-English",
      "evaluation": {
        "type": "official_test",
        "samples": 1000
      },
      "models": [
        {
          "name": "mBERT",
          "data_setup": "Natural Only",
          "paper_f1": 0.750,
          "reproduced_f1": 0.733,
          "difference": -0.017
        },
        {
          "name": "XLM-T",
          "data_setup": "Natural Only",
          "paper_f1": 0.843,
          "reproduced_f1": 0.734,
          "difference": -0.109
        },
        {
          "name": "XLM-T",
          "data_setup": "Natural + LLM Synthetic",
          "paper_f1": 0.763,
          "reproduced_f1": 0.744,
          "difference": 0.019
        },
        {
          "name": "mBERT",
          "data_setup": "Natural + LLM Synthetic",
          "paper_f1": 0.745,
          "reproduced_f1": 0.727,
          "difference": -0.018
        }
      ],
      "notes": [
        "mBERT is stable across configurations",
        "Largest deviation in XLM-T baseline (-0.109)",
        "Malayalam tokenization and preprocessing likely cause of gap"
      ]
    },
